@page "/proyectos"
@layout MainLayout
@using System.Collections.Generic
@using System.Linq
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<section class="mx-auto max-w-[1400px] px-6 pb-4 pt-14 lg:px-10">
    <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-medium uppercase tracking-[0.14em] text-text-secondary">Panel interno</p>
            <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">Proyectos</h1>
        </div>
        <button type="button" class="btn-primary" @onclick="OpenCreateModal">
            <Icon Name="project" CssClass="h-4 w-4" />
            Nuevo proyecto
        </button>
    </div>
</section>

<section class="mx-auto max-w-[1400px] px-6 pb-16 lg:px-10">
    @if (loading)
    {
        <p class="text-text-secondary">Cargando proyectos...</p>
    }
    else if (errorMessage is not null)
    {
        <p class="text-danger">@errorMessage</p>
    }
    else if (!proyectos.Any())
    {
        <div class="surface-card reveal p-10 text-center text-text-secondary">
            Todavía no hay proyectos cargados.
        </div>
    }
    else
    {
        <div class="surface-card reveal hidden overflow-hidden md:block">
            <table class="w-full text-left text-sm">
                <thead class="border-b border-white/[0.06] text-xs uppercase tracking-wider text-text-secondary">
                    <tr>
                        <th class="px-6 py-4 font-medium">Proyecto</th>
                        <th class="px-6 py-4 font-medium">Cliente</th>
                        <th class="px-6 py-4 font-medium">Estado</th>
                        <th class="px-6 py-4 font-medium">Tarifa</th>
                        <th class="px-6 py-4 font-medium">Sesiones</th>
                        <th class="px-6 py-4 font-medium"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.06]">
                    @foreach (var proyecto in proyectos)
                    {
                        <tr class="transition-colors duration-200 hover:bg-white/[0.03]">
                            <td class="px-6 py-4">
                                <div class="font-medium text-white">@proyecto.Nombre</div>
                                @if (!string.IsNullOrWhiteSpace(proyecto.Referencia))
                                {
                                    <div class="text-xs text-text-secondary">Ref: @proyecto.Referencia</div>
                                }
                            </td>
                            <td class="px-6 py-4 text-text-secondary">@proyecto.Cliente?.NombreCompleto</td>
                            <td class="px-6 py-4"><span class="tag-pill">@EstadoLabel(proyecto.Estado)</span></td>
                            <td class="px-6 py-4 text-text-secondary">@TarifaLabel(proyecto.Tarifa)</td>
                            <td class="px-6 py-4 text-text-secondary">@proyecto.CantidadSesiones</td>
                            <td class="px-6 py-4 text-right">
                                <a href="@($"/sesiones/{proyecto.Id}")" class="inline-flex items-center gap-1.5 rounded-lg border border-primary/40 bg-primary/15 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-primary/25" aria-label="Agregar o ver sesiones">
                                    <Icon Name="calendar" CssClass="h-4 w-4" />
                                    Sesiones
                                </a>
                                <button type="button" class="ml-3 text-text-secondary transition-colors hover:text-white" @onclick="() => OpenEditModal(proyecto)" aria-label="Editar proyecto">
                                    <Icon Name="editing" CssClass="h-4 w-4" />
                                </button>
                                @if (proyecto.Estado is EstadoProyecto.Presupuesto or EstadoProyecto.EnCurso)
                                {
                                    <button type="button" class="ml-3 text-xs font-medium text-success hover:underline" @onclick="() => FinalizarProyecto(proyecto)">
                                        Finalizar
                                    </button>
                                    <button type="button" class="ml-3 text-xs font-medium text-danger hover:underline" @onclick="() => CancelarProyecto(proyecto)">
                                        Cancelar
                                    </button>
                                }
                                <button type="button" class="ml-3 text-text-secondary transition-colors hover:text-danger" @onclick="() => DeleteProyecto(proyecto)" aria-label="Eliminar proyecto">
                                    <Icon Name="close" CssClass="h-4 w-4" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="space-y-3 md:hidden">
            @foreach (var proyecto in proyectos)
            {
                <div class="surface-card reveal p-5">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="font-medium text-white">@proyecto.Nombre</p>
                            @if (!string.IsNullOrWhiteSpace(proyecto.Referencia))
                            {
                                <p class="text-xs text-text-secondary">Ref: @proyecto.Referencia</p>
                            }
                            <p class="mt-1 text-sm text-text-secondary">@proyecto.Cliente?.NombreCompleto</p>
                        </div>
                        <span class="tag-pill shrink-0">@EstadoLabel(proyecto.Estado)</span>
                    </div>

                    <dl class="mt-4 grid grid-cols-2 gap-3 text-sm">
                        <div>
                            <dt class="text-xs uppercase tracking-wider text-text-secondary">Tarifa</dt>
                            <dd class="mt-0.5 text-white">@TarifaLabel(proyecto.Tarifa)</dd>
                        </div>
                        <div>
                            <dt class="text-xs uppercase tracking-wider text-text-secondary">Sesiones</dt>
                            <dd class="mt-0.5 text-white">@proyecto.CantidadSesiones</dd>
                        </div>
                    </dl>

                    <div class="mt-4 flex flex-wrap items-center gap-4 border-t border-white/[0.06] pt-4">
                        <a href="@($"/sesiones/{proyecto.Id}")" class="inline-flex items-center gap-1.5 rounded-lg border border-primary/40 bg-primary/15 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-primary/25">
                            <Icon Name="calendar" CssClass="h-4 w-4" />
                            Sesiones
                        </a>
                        <button type="button" class="flex items-center gap-1.5 text-xs font-medium text-text-secondary hover:text-white" @onclick="() => OpenEditModal(proyecto)">
                            <Icon Name="editing" CssClass="h-4 w-4" />
                            Editar
                        </button>
                        @if (proyecto.Estado is EstadoProyecto.Presupuesto or EstadoProyecto.EnCurso)
                        {
                            <button type="button" class="text-xs font-medium text-success hover:underline" @onclick="() => FinalizarProyecto(proyecto)">
                                Finalizar
                            </button>
                            <button type="button" class="text-xs font-medium text-danger hover:underline" @onclick="() => CancelarProyecto(proyecto)">
                                Cancelar
                            </button>
                        }
                        <button type="button" class="ml-auto flex items-center gap-1.5 text-xs font-medium text-text-secondary hover:text-danger" @onclick="() => DeleteProyecto(proyecto)">
                            <Icon Name="close" CssClass="h-4 w-4" />
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (showModal)
{
    <ProyectoFormModal Proyecto="editingProyecto" OnSaved="HandleSaved" OnCancelled="CloseModal" />
}

@code {
    private List<Proyecto> proyectos = new();
    private bool loading = true;
    private string errorMessage;
    private bool showModal;
    private Proyecto editingProyecto;

    protected override async Task OnInitializedAsync()
    {
        await LoadProyectos();
    }

    private async Task LoadProyectos()
    {
        loading = true;
        errorMessage = null;
        try
        {
            proyectos = await Http.GetFromJsonAsync<List<Proyecto>>("api/proyectos") ?? new List<Proyecto>();
        }
        catch (Exception)
        {
            errorMessage = "No se pudieron cargar los proyectos.";
        }
        finally
        {
            loading = false;
        }
    }

    private static string EstadoLabel(EstadoProyecto estado) => estado switch
    {
        EstadoProyecto.Presupuesto => "Presupuesto",
        EstadoProyecto.EnCurso => "En curso",
        EstadoProyecto.Finalizado => "Finalizado",
        EstadoProyecto.Cancelado => "Cancelado",
        _ => estado.ToString()
    };

    private static string TarifaLabel(Tarifa tarifa)
    {
        if (tarifa is null) return "—";
        return tarifa.Modalidad == ModalidadTarifa.PorHora
            ? $"{tarifa.Valor:0.##}/hora"
            : $"Paquete {tarifa.Valor:0.##}";
    }

    private void OpenCreateModal()
    {
        editingProyecto = new Proyecto();
        showModal = true;
    }

    private void OpenEditModal(Proyecto proyecto)
    {
        editingProyecto = new Proyecto
        {
            Id = proyecto.Id,
            Nombre = proyecto.Nombre,
            Referencia = proyecto.Referencia,
            ClienteId = proyecto.ClienteId,
            FechaInicio = proyecto.FechaInicio,
            Estado = proyecto.Estado,
            ProductorResponsableId = proyecto.ProductorResponsableId,
            HorasContratadas = proyecto.HorasContratadas,
            Tarifa = new Tarifa
            {
                Id = proyecto.Tarifa?.Id ?? 0,
                ProyectoId = proyecto.Id,
                Modalidad = proyecto.Tarifa?.Modalidad ?? ModalidadTarifa.PorHora,
                Valor = proyecto.Tarifa?.Valor ?? 0,
                FechaAcuerdo = proyecto.Tarifa?.FechaAcuerdo ?? DateTime.UtcNow.Date
            }
        };
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSaved()
    {
        showModal = false;
        await LoadProyectos();
    }

    private async Task FinalizarProyecto(Proyecto proyecto)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"¿Marcar \"{proyecto.Nombre}\" como Finalizado?");
        if (!confirmed) return;

        var response = await Http.PutAsync($"api/proyectos/{proyecto.Id}/finalizar", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadProyectos();
        }
    }

    private async Task CancelarProyecto(Proyecto proyecto)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"¿Cancelar el proyecto \"{proyecto.Nombre}\"?");
        if (!confirmed) return;

        var response = await Http.PutAsync($"api/proyectos/{proyecto.Id}/cancelar", null);
        if (response.IsSuccessStatusCode)
        {
            await LoadProyectos();
        }
    }

    private async Task DeleteProyecto(Proyecto proyecto)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", $"¿Eliminar el proyecto \"{proyecto.Nombre}\"?");
        if (!confirmed) return;

        var response = await Http.DeleteAsync($"api/proyectos/{proyecto.Id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadProyectos();
        }
    }
}
