@page "/sesiones/{ProyectoId:int}"
@layout MainLayout
@using System.Collections.Generic
@using System.Linq
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<section class="mx-auto max-w-[1400px] px-6 pb-4 pt-14 lg:px-10">
    <div class="reveal flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-sm font-medium uppercase tracking-[0.14em] text-text-secondary">Panel interno</p>
            <h1 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
                Sesiones @(proyecto is not null ? $"— {proyecto.Nombre}" : "")
            </h1>
        </div>
        <button type="button" class="btn-primary" @onclick="OpenCreateModal">
            <Icon Name="calendar" CssClass="h-4 w-4" />
            Nueva sesión
        </button>
    </div>
</section>

<section class="mx-auto max-w-[1400px] px-6 lg:px-10">
    @if (resumen is not null)
    {
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div class="surface-card p-5">
                <p class="text-xs uppercase tracking-wider text-text-secondary">Horas contratadas</p>
                <p class="mt-2 text-2xl font-bold text-white">@(resumen.HorasContratadas?.ToString("0.##") ?? "Sin límite")</p>
            </div>
            <div class="surface-card p-5">
                <p class="text-xs uppercase tracking-wider text-text-secondary">Horas usadas</p>
                <p class="mt-2 text-2xl font-bold text-accent">@resumen.HorasUsadas.ToString("0.##")</p>
            </div>
            <div class="surface-card p-5">
                <p class="text-xs uppercase tracking-wider text-text-secondary">Horas disponibles</p>
                <p class="mt-2 text-2xl font-bold @(resumen.HorasDisponibles is < 0 ? "text-danger" : "text-success")">
                    @(resumen.HorasDisponibles?.ToString("0.##") ?? "—")
                </p>
            </div>
        </div>
    }
</section>

<section class="mx-auto max-w-[1400px] px-6 pb-16 pt-6 lg:px-10">
    @if (loading)
    {
        <p class="text-text-secondary">Cargando sesiones...</p>
    }
    else if (errorMessage is not null)
    {
        <p class="text-danger">@errorMessage</p>
    }
    else if (!sesiones.Any())
    {
        <div class="surface-card reveal p-10 text-center text-text-secondary">
            Todavía no hay sesiones cargadas para este proyecto.
        </div>
    }
    else
    {
        <div class="surface-card reveal hidden overflow-hidden md:block">
            <div class="overflow-x-auto">
            <table class="w-full min-w-[820px] text-left text-sm">
                <thead class="border-b border-white/[0.06] text-xs uppercase tracking-wider text-text-secondary">
                    <tr>
                        <th class="px-6 py-4 font-medium">Inicio</th>
                        <th class="px-6 py-4 font-medium">Fin</th>
                        <th class="px-6 py-4 font-medium">Responsable</th>
                        <th class="px-6 py-4 font-medium">Estudio</th>
                        <th class="px-6 py-4 font-medium">Tareas</th>
                        <th class="px-6 py-4 font-medium">Horas</th>
                        <th class="px-6 py-4 font-medium"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-white/[0.06]">
                    @foreach (var sesion in sesiones)
                    {
                        <tr class="transition-colors duration-200 hover:bg-white/[0.03]">
                            <td class="px-6 py-4 text-white">@sesion.FechaInicio.ToString("dd/MM/yy HH:mm")</td>
                            <td class="px-6 py-4">
                                @if (sesion.Abierta)
                                {
                                    <span class="tag-pill" style="border-color:rgba(245,158,11,.4); background:rgba(245,158,11,.12); color:#ffce7a;">Abierta</span>
                                }
                                else
                                {
                                    <span class="text-text-secondary">@sesion.FechaFin?.ToString("dd/MM/yy HH:mm")</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-text-secondary">@NombreUsuario(sesion.ResponsableId)</td>
                            <td class="px-6 py-4 text-text-secondary">@sesion.Estudio?.Nombre</td>
                            <td class="px-6 py-4 text-text-secondary">@string.Join(", ", sesion.Tareas.Select(t => t.TareaCatalogo?.Nombre))</td>
                            <td class="px-6 py-4 text-text-secondary">@(sesion.CantidadHoras?.ToString("0.##") ?? "—")</td>
                            <td class="px-6 py-4 text-right">
                                @if (sesion.Abierta)
                                {
                                    <button type="button" class="tag-pill mr-3 border-success/40 bg-success/15 text-success hover:bg-success/25" @onclick="() => OpenCloseModal(sesion)">
                                        <Icon Name="check" CssClass="h-3.5 w-3.5" />
                                        Cerrar
                                    </button>
                                }
                                <button type="button" class="text-text-secondary transition-colors hover:text-white" @onclick="() => OpenEditModal(sesion)" aria-label="Editar sesión">
                                    <Icon Name="editing" CssClass="h-4 w-4" />
                                </button>
                                <button type="button" class="ml-3 text-text-secondary transition-colors hover:text-danger" @onclick="() => DeleteSesion(sesion)" aria-label="Eliminar sesión">
                                    <Icon Name="close" CssClass="h-4 w-4" />
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>

        <div class="space-y-3 md:hidden">
            @foreach (var sesion in sesiones)
            {
                <div class="surface-card reveal p-5">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <p class="font-medium text-white">@sesion.FechaInicio.ToString("dd/MM/yy HH:mm")</p>
                            @if (!sesion.Abierta)
                            {
                                <p class="text-sm text-text-secondary">Fin: @sesion.FechaFin?.ToString("dd/MM/yy HH:mm")</p>
                            }
                        </div>
                        @if (sesion.Abierta)
                        {
                            <span class="tag-pill shrink-0" style="border-color:rgba(245,158,11,.4); background:rgba(245,158,11,.12); color:#ffce7a;">Abierta</span>
                        }
                    </div>

                    <dl class="mt-4 space-y-2 text-sm">
                        <div class="flex justify-between gap-3">
                            <dt class="text-text-secondary">Responsable</dt>
                            <dd class="text-white">@NombreUsuario(sesion.ResponsableId)</dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-text-secondary">Estudio</dt>
                            <dd class="text-white">@sesion.Estudio?.Nombre</dd>
                        </div>
                        <div class="flex justify-between gap-3">
                            <dt class="text-text-secondary">Horas</dt>
                            <dd class="text-white">@(sesion.CantidadHoras?.ToString("0.##") ?? "—")</dd>
                        </div>
                        @if (sesion.Tareas.Any())
                        {
                            <div>
                                <dt class="text-text-secondary">Tareas</dt>
                                <dd class="mt-0.5 text-white">@string.Join(", ", sesion.Tareas.Select(t => t.TareaCatalogo?.Nombre))</dd>
                            </div>
                        }
                    </dl>

                    <div class="mt-4 flex flex-wrap items-center gap-4 border-t border-white/[0.06] pt-4">
                        @if (sesion.Abierta)
                        {
                            <button type="button" class="tag-pill border-success/40 bg-success/15 text-success hover:bg-success/25" @onclick="() => OpenCloseModal(sesion)">
                                <Icon Name="check" CssClass="h-3.5 w-3.5" />
                                Cerrar
                            </button>
                        }
                        <button type="button" class="flex items-center gap-1.5 text-xs font-medium text-text-secondary hover:text-white" @onclick="() => OpenEditModal(sesion)">
                            <Icon Name="editing" CssClass="h-4 w-4" />
                            Editar
                        </button>
                        <button type="button" class="ml-auto flex items-center gap-1.5 text-xs font-medium text-text-secondary hover:text-danger" @onclick="() => DeleteSesion(sesion)">
                            <Icon Name="close" CssClass="h-4 w-4" />
                            Eliminar
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</section>

@if (showModal)
{
    <SesionFormModal Sesion="editingSesion" ProyectoId="ProyectoId" OnSaved="HandleSaved" OnCancelled="CloseModal" />
}

@code {
    [Parameter] public int ProyectoId { get; set; }
    [SupplyParameterFromQuery] public bool Nueva { get; set; }

    private Proyecto proyecto;
    private ResumenHorasProyecto resumen;
    private List<Sesion> sesiones = new();
    private List<UsuarioResumen> staff = new();
    private bool loading = true;
    private string errorMessage;
    private bool showModal;
    private Sesion editingSesion;

    protected override async Task OnInitializedAsync()
    {
        await CargarTodo();

        if (Nueva)
        {
            OpenCreateModal();
        }
    }

    private async Task CargarTodo()
    {
        loading = true;
        errorMessage = null;
        try
        {
            proyecto = await Http.GetFromJsonAsync<Proyecto>($"api/proyectos/{ProyectoId}");
            resumen = await Http.GetFromJsonAsync<ResumenHorasProyecto>($"api/sesiones/resumen/{ProyectoId}");
            staff = await Http.GetFromJsonAsync<List<UsuarioResumen>>("api/usuarios/staff") ?? new List<UsuarioResumen>();
            sesiones = await Http.GetFromJsonAsync<List<Sesion>>($"api/sesiones?proyectoId={ProyectoId}") ?? new List<Sesion>();
        }
        catch (Exception)
        {
            errorMessage = "No se pudieron cargar las sesiones.";
        }
        finally
        {
            loading = false;
        }
    }

    private string NombreUsuario(int id) => staff.FirstOrDefault(u => u.Id == id)?.NombreCompleto ?? "—";

    private void OpenCreateModal()
    {
        editingSesion = new Sesion { ProyectoId = ProyectoId };
        showModal = true;
    }

    private void OpenEditModal(Sesion sesion)
    {
        editingSesion = new Sesion
        {
            Id = sesion.Id,
            ProyectoId = sesion.ProyectoId,
            FechaInicio = sesion.FechaInicio,
            FechaFin = sesion.FechaFin,
            CantidadHoras = sesion.CantidadHoras,
            ResponsableId = sesion.ResponsableId,
            Descripcion = sesion.Descripcion,
            EstudioId = sesion.EstudioId,
            Observaciones = sesion.Observaciones,
            TareaCatalogoIds = sesion.Tareas.Select(t => t.TareaCatalogoId).ToList()
        };
        showModal = true;
    }

    private void OpenCloseModal(Sesion sesion)
    {
        editingSesion = new Sesion
        {
            Id = sesion.Id,
            ProyectoId = sesion.ProyectoId,
            FechaInicio = sesion.FechaInicio,
            FechaFin = DateTime.Now,
            CantidadHoras = sesion.CantidadHoras,
            ResponsableId = sesion.ResponsableId,
            Descripcion = sesion.Descripcion,
            EstudioId = sesion.EstudioId,
            Observaciones = sesion.Observaciones,
            TareaCatalogoIds = sesion.Tareas.Select(t => t.TareaCatalogoId).ToList()
        };
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSaved()
    {
        showModal = false;
        await CargarTodo();
    }

    private async Task DeleteSesion(Sesion sesion)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm", "¿Eliminar esta sesión?");
        if (!confirmed) return;

        var response = await Http.DeleteAsync($"api/sesiones/{sesion.Id}");
        if (response.IsSuccessStatusCode)
        {
            await CargarTodo();
        }
    }
}
