{
  "name": "nexo-client-styles",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind CSS build pipeline for the JCB Studio / Nexo Blazor client.",
  "scripts": {
    "build:css": "tailwindcss -i ./Styles/app.tailwind.css -o ./wwwroot/css/app.css --minify",
    "watch:css": "tailwindcss -i ./Styles/app.tailwind.css -o ./wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.14"
  }
}
