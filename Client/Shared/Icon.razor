@* Centralized inline-SVG icon set. Keeping every icon in one switch avoids scattering
   raw path data across the component tree and makes it trivial to swap the visual
   language later (e.g. for a licensed icon font) without touching call sites. *@

<svg class="@CssClass" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@StrokeWidth" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "project":
            <path d="M4 19V6a1 1 0 0 1 1-1h5l2 2h7a1 1 0 0 1 1 1v3" />
            <path d="M4 19h16a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1z" />
            break;
        case "artist":
            <circle cx="9" cy="8" r="3" />
            <path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" />
            <circle cx="17.5" cy="9.5" r="2.3" />
            <path d="M15 20c.2-2.4 1.7-4 3.8-4.3" />
            break;
        case "calendar":
            <rect x="3.5" y="5" width="17" height="16" rx="2" />
            <path d="M3.5 10h17M8 3v4M16 3v4" />
            break;
        case "production":
            <path d="M4 13a8 8 0 0 1 16 0" />
            <rect x="3" y="13" width="4" height="6" rx="1.3" />
            <rect x="17" y="13" width="4" height="6" rx="1.3" />
            break;
        case "tasks":
            <rect x="4" y="4" width="16" height="16" rx="3" />
            <path d="m8.5 12 2.2 2.2L15.5 9" />
            break;
        case "files":
            <path d="M4 7a2 2 0 0 1 2-2h3.5l1.6 2H18a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z" />
            break;
        case "budget":
            <rect x="3" y="6" width="18" height="13" rx="2" />
            <path d="M3 10h18" />
            <circle cx="8" cy="14.5" r="1.4" />
            break;
        case "reports":
            <path d="M4 20V10M11 20V4M18 20v-7" />
            <path d="M4 20h16" />
            break;
        case "launch":
            <path d="M12 3c2.8 1.6 4.5 4.4 4.5 8.5 0 2-.6 3.7-1.6 5L12 21l-2.9-4.5c-1-1.3-1.6-3-1.6-5C7.5 7.4 9.2 4.6 12 3Z" />
            <circle cx="12" cy="10.5" r="1.8" />
            <path d="M9 18.5c-1.8.4-3 1.3-3 2.5M15 18.5c1.8.4 3 1.3 3 2.5" />
            break;
        case "bell":
            <path d="M6 10a6 6 0 0 1 12 0c0 4 1.2 5.4 1.5 6H4.5C4.8 15.4 6 14 6 10Z" />
            <path d="M10 19a2 2 0 0 0 4 0" />
            break;
        case "gear":
            <circle cx="12" cy="12" r="3" />
            <path d="M12 3v2.2M12 18.8V21M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M3 12h2.2M18.8 12H21M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6" />
            break;
        case "arrow-right":
            <path d="M4.5 12h15M13.5 6l6 6-6 6" />
            break;
        case "chevron-right":
            <path d="m9 6 6 6-6 6" />
            break;
        case "trend-up":
            <path d="M4 16.5 10 10l4 4 6.5-7" />
            <path d="M15 6.5h5.5V12" />
            break;
        case "trend-down":
            <path d="M4 8.5 10 15l4-4 6.5 7" />
            <path d="M15 18.5h5.5V13" />
            break;
        case "idea":
            <path d="M9 18h6M10 21h4" />
            <path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1 2.2h5.2c0-1 .4-1.7 1-2.2A6 6 0 0 0 12 3Z" />
            break;
        case "preproduction":
            <rect x="6" y="4" width="12" height="17" rx="2" />
            <path d="M9 3.5h6v2H9zM9 9.5h6M9 13h6M9 16.5h3.5" />
            break;
        case "recording":
            <rect x="9.5" y="3" width="5" height="10" rx="2.5" />
            <path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6" />
            break;
        case "editing":
            <path d="M4 6h16M4 12h10M4 18h6" />
            <circle cx="17" cy="6" r="1.6" />
            <circle cx="14" cy="12" r="1.6" />
            <circle cx="9" cy="18" r="1.6" />
            break;
        case "mixing":
            <path d="M5 20V10M12 20V4M19 20v-7" />
            <circle cx="5" cy="8" r="1.8" />
            <circle cx="12" cy="14" r="1.8" />
            <circle cx="19" cy="9" r="1.8" />
            break;
        case "mastering":
            <circle cx="12" cy="12" r="8.5" />
            <circle cx="12" cy="12" r="2.2" />
            break;
        case "distribution":
            <circle cx="6" cy="12" r="2.4" />
            <circle cx="18" cy="6" r="2.4" />
            <circle cx="18" cy="18" r="2.4" />
            <path d="m8.2 10.8 7.6-3.6M8.2 13.2l7.6 3.6" />
            break;
        case "close":
            <path d="m6 6 12 12M18 6 6 18" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        default:
            <circle cx="12" cy="12" r="8.5" />
            break;
    }
</svg>

@code {
    /// <summary>Icon key — see the switch above for the full supported set.</summary>
    [Parameter] public string Name { get; set; } = "";

    [Parameter] public string CssClass { get; set; } = "h-5 w-5";

    [Parameter] public string StrokeWidth { get; set; } = "1.75";
}
