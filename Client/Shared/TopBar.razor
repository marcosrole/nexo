<header class="sticky top-0 z-50 border-b border-white/[0.06] bg-background/80 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-6 lg:px-10">

        <a href="@(sesion is not null ? "/dashboard" : "/")" class="flex items-center gap-3">
            <img src="images/logo-jcb-transparente.png" alt="JCB Studio" class="h-9 w-9 object-contain" />
            <span class="leading-tight">
                <span class="block text-[15px] font-semibold tracking-tight text-white">JCB Studio</span>
                <span class="block text-[10px] font-medium uppercase tracking-[0.14em] text-text-secondary">Powered by Nexo</span>
            </span>
        </a>

        @if (sesion is not null)
        {
            <nav class="hidden items-center gap-6 text-sm font-medium text-text-secondary md:flex">
                <a href="/dashboard" class="transition-colors duration-200 hover:text-white">Dashboard</a>
                <a href="/proyectos" class="transition-colors duration-200 hover:text-white">Proyectos</a>
                <a href="/clientes" class="transition-colors duration-200 hover:text-white">Clientes</a>
                <a href="/" class="transition-colors duration-200 hover:text-white">Inicio</a>
            </nav>
        }

        <div class="flex items-center gap-2">
            <button type="button" aria-label="Notificaciones"
                    class="relative flex h-10 w-10 items-center justify-center rounded-xl text-text-secondary transition-colors duration-200 hover:bg-white/5 hover:text-white">
                <Icon Name="bell" CssClass="h-5 w-5" />
                <span class="absolute right-2.5 top-2.5 h-1.5 w-1.5 rounded-full bg-accent"></span>
            </button>

            <button type="button" aria-label="Configuración"
                    class="flex h-10 w-10 items-center justify-center rounded-xl text-text-secondary transition-colors duration-200 hover:bg-white/5 hover:text-white">
                <Icon Name="gear" CssClass="h-5 w-5" />
            </button>

            @if (sesion is not null)
            {
                <div class="ml-1 flex items-center gap-2">
                    <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-surface to-white/10 text-xs font-semibold text-white ring-1 ring-white/10"
                         title="@sesion.NombreCompleto (@string.Join(", ", sesion.Roles))">
                        @Iniciales(sesion.NombreCompleto)
                    </div>
                    <form method="post" action="/Identity/Account/Logout">
                        <button type="submit" class="text-xs font-medium text-text-secondary transition-colors hover:text-white">
                            Salir
                        </button>
                    </form>
                </div>
            }
            else if (!cargandoSesion)
            {
                <a href="/Identity/Account/Login?returnUrl=%2Fdashboard" class="btn-secondary !px-4 !py-2 text-xs">Ingresar</a>
            }
        </div>
    </div>
</header>

@code {
    [Inject] private HttpClient Http { get; set; }

    private SesionActual sesion;
    private bool cargandoSesion = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync("api/account/me");
            if (response.IsSuccessStatusCode)
            {
                sesion = await response.Content.ReadFromJsonAsync<SesionActual>();
            }
        }
        catch (Exception)
        {
            // Sin sesión iniciada o servidor no disponible: se muestra el link de login.
        }
        finally
        {
            cargandoSesion = false;
        }
    }

    private static string Iniciales(string nombreCompleto)
    {
        if (string.IsNullOrWhiteSpace(nombreCompleto)) return "?";

        var partes = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length switch
        {
            0 => "?",
            1 => partes[0].Substring(0, 1).ToUpperInvariant(),
            _ => (partes[0].Substring(0, 1) + partes[^1].Substring(0, 1)).ToUpperInvariant()
        };
    }
}
