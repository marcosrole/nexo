<header class="sticky top-0 z-50 border-b border-white/[0.06] bg-background/80 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-6 lg:px-10">

        <a href="/" class="flex items-center gap-3">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-gradient-to-br from-primary to-accent text-sm font-bold text-white shadow-glow">
                JC
            </span>
            <span class="leading-tight">
                <span class="block text-[15px] font-semibold tracking-tight text-white">JCB Studio</span>
                <span class="block text-[10px] font-medium uppercase tracking-[0.14em] text-text-secondary">Powered by Nexo</span>
            </span>
        </a>

        <div class="flex items-center gap-2">
            <button type="button" aria-label="Notificaciones"
                    class="relative flex h-10 w-10 items-center justify-center rounded-xl text-text-secondary transition-colors duration-200 hover:bg-white/5 hover:text-white">
                <Icon Name="bell" CssClass="h-5 w-5" />
                <span class="absolute right-2.5 top-2.5 h-1.5 w-1.5 rounded-full bg-accent"></span>
            </button>

            <button type="button" aria-label="Configuración"
                    class="flex h-10 w-10 items-center justify-center rounded-xl text-text-secondary transition-colors duration-200 hover:bg-white/5 hover:text-white">
                <Icon Name="gear" CssClass="h-5 w-5" />
            </button>

            <div class="ml-1 flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-surface to-white/10 text-xs font-semibold text-white ring-1 ring-white/10">
                @UserInitials
            </div>
        </div>
    </div>
</header>

@code {
    /// <summary>Initials shown in the avatar badge until real auth/profile data is wired in.</summary>
    [Parameter] public string UserInitials { get; set; } = "MR";
}
