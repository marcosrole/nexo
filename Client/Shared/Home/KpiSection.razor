<section class="mx-auto max-w-[1400px] px-6 py-16 lg:px-10">
    <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-6">
        @foreach (var kpi in Kpis)
        {
            <KpiCard Item="kpi" />
        }
    </div>
</section>

