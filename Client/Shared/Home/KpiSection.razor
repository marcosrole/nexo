    private static readonly KpiItem[] Kpis =
    {
        new("project",    "24",  "Proyectos activos",      "+12%", true),
        new("production", "9",   "Producciones en curso",  "+4%",  true),
        new("artist",     "38",  "Artistas registrados",    "+2",  true),
        new("launch",     "5",   "Próximos lanzamientos",   "Esta semana", true),
        new("tasks",      "17",  "Tareas pendientes",       "-6%",  false),
        new("budget",     "6",   "Presupuestos abiertos",   "+1",  true),
    };
}
