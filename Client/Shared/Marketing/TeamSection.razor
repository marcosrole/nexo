<section id="equipo" class="mx-auto max-w-[1400px] scroll-mt-24 px-6 py-16 lg:px-10">
    <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Quiénes somos</h2>
        <p class="mt-4 text-text-secondary">Las personas detrás de cada producción.</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-3xl grid-cols-1 gap-6 sm:grid-cols-2">
        @foreach (var miembro in Miembros)
        {
            <div class="reveal surface-card flex flex-col items-center p-8 text-center">
                <span class="flex h-24 w-24 items-center justify-center rounded-full bg-gradient-to-br from-primary to-accent text-2xl font-semibold text-white">
                    @miembro.Nombre.Substring(0, 1)
                </span>
                <h3 class="mt-5 text-lg font-semibold text-white">@miembro.Nombre</h3>
            </div>
        }
    </div>
</section>

@code {
    private static readonly TeamMember[] Miembros =
    {
        new("Lucía Role"),
        new("Alfredo Barrios"),
    };
}
