<section class="mx-auto max-w-[1400px] px-6 py-16 lg:px-10">
    <div class="reveal mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Lo que dicen de nosotros</h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-3">
        @foreach (var item in Testimonials)
        {
            <div class="reveal surface-card p-6">
                <p class="text-sm leading-relaxed text-white/90">&ldquo;@item.Quote&rdquo;</p>
                <div class="mt-5 flex items-center gap-3">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gradient-to-br from-primary to-accent text-xs font-semibold text-white">
                        @item.Author.Substring(0, 1)
                    </span>
                    <div>
                        <p class="text-sm font-semibold text-white">@item.Author</p>
                        <p class="text-xs text-text-secondary">@item.Role</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private static readonly Testimonial[] Testimonials =
    {
        new("JCB Studio entendió nuestra visión desde el primer día. El mastering final superó lo que imaginábamos.", "Lucía Fernández", "Cantautora"),
        new("Profesionalismo y oído artístico en partes iguales. Nuestro EP sonó como el de un sello grande.", "Nico Ibarra", "Productor, Sello Marea"),
        new("Cumplieron los tiempos, cuidaron cada detalle y el resultado se nota en cada plataforma.", "Banda Circuito", "Grupo electrónico"),
    };
}
